<Window
    x:Class="DeltaStringBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="三角洲行动 · StringTables 归类浏览器">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- 业务域列表项 -->
            <DataTemplate x:Key="DomainItemTemplate">
            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{Binding Name}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- 表列表项 -->
        <DataTemplate x:Key="TableItemTemplate">
            <Grid RowSpacing="2" ToolTipService.ToolTip="{Binding PathText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FileName}" FontFamily="Consolas" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11" Opacity="0.65" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding PathText}" FontSize="10" Opacity="0.45" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!-- 条目列表项：Key / 文本预览 -->
        <DataTemplate x:Key="EntryItemTemplate">
            <Grid RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3"
                            Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FieldLabel}" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Key}" FontFamily="Consolas" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding IdText}" FontSize="10.5" Opacity="0.55"
                               VerticalAlignment="Center" FontFamily="Consolas" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Preview}" FontSize="12" Opacity="0.8"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 顶部工具条 ================= -->
        <Border Grid.Row="0" Padding="12,10"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel VerticalAlignment="Center" MinWidth="250">
                    <TextBlock Text="三角洲 StringTables 归类浏览器" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="RootPathText" FontSize="10.5" Opacity="0.6"
                               TextTrimming="CharacterEllipsis" MaxWidth="340" />
                    <!-- Alpha 定时过期版角标：仅 ALPHA_EXPIRY 构建由代码显示，正式版恒为折叠 -->
                    <TextBlock x:Name="AlphaBadge" FontSize="10.5" Foreground="#D96A0B"
                               TextTrimming="CharacterEllipsis" MaxWidth="340" Visibility="Collapsed" />
                </StackPanel>

                <Border Width="1" VerticalAlignment="Stretch"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0" />

                <DropDownButton x:Name="ImportButton" VerticalAlignment="Center"
                                AutomationProperties.Name="导入"
                                ToolTipService.ToolTip="导入数据源：文件夹或 ZIP 包（会记住上次用的）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock Text="导入" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem x:Name="ImportFolderItem" Text="导入文件夹…" Click="ImportFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ImportZipItem" Text="导入 ZIP 包…" Click="ImportZip_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7B8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="ClearImportCacheItem" Text="清理解压缓存" Click="ClearImportCache_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="ReloadButton" Click="ReloadButton_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="重新加载" />
                    </StackPanel>
                </Button>

                <TextBox x:Name="SearchBox" Width="300" VerticalAlignment="Center"
                         PlaceholderText="搜索 Key / 文本…" TextChanged="SearchBox_TextChanged" />

                <ComboBox x:Name="TagFilter" Width="150" VerticalAlignment="Center"
                          SelectionChanged="Filter_SelectionChanged" />
                <ComboBox x:Name="FieldFilter" Width="160" VerticalAlignment="Center"
                          SelectionChanged="Filter_SelectionChanged" />

                <DropDownButton x:Name="ThemeButton" VerticalAlignment="Center"
                                AutomationProperties.Name="外观"
                                ToolTipService.ToolTip="外观：跟随系统 / 浅色 / 深色">
                    <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="14" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="跟随系统"
                                                 GroupName="themeMode" Click="ThemeItem_Click" Tag="System"/>
                            <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="浅色"
                                                 GroupName="themeMode" Click="ThemeItem_Click" Tag="Light"/>
                            <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="深色"
                                                 GroupName="themeMode" Click="ThemeItem_Click" Tag="Dark"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Border>

        <!-- ================= 主区三栏 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- 左：业务域 + 表 -->
            <Border Grid.Column="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="10,8" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="业务分类" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock x:Name="DomainTotalText" Grid.Column="1" FontSize="11" Opacity="0.6" />
                    </Grid>
                    <ListView x:Name="DomainList" Grid.Row="1" ItemTemplate="{StaticResource DomainItemTemplate}"
                              SelectionChanged="DomainList_SelectionChanged" MaxHeight="240"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="表 (选择后浏览该表; 不选 = 全部分类)" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock x:Name="TableTotalText" Grid.Column="1" FontSize="11" Opacity="0.6" />
                    </Grid>
                    <ListView x:Name="TableList" Grid.Row="3" ItemTemplate="{StaticResource TableItemTemplate}"
                              SelectionChanged="TableList_SelectionChanged" IsItemClickEnabled="False" />
                </Grid>
            </Border>

            <!-- 中：条目列表 -->
            <Grid Grid.Column="1" Padding="10,8" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="ScopeHeader" Text="—" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock x:Name="MatchInfo" FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                </StackPanel>
                <ListView x:Name="EntryList" Grid.Row="1" ItemTemplate="{StaticResource EntryItemTemplate}"
                          SelectionChanged="EntryList_SelectionChanged" DoubleTapped="EntryList_DoubleTapped"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Grid>

            <!-- 右：详情 -->
            <Border Grid.Column="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="12,10" Spacing="8">
                        <TextBlock Text="条目详情" FontWeight="SemiBold" FontSize="13.5" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CopyKeyButton" Click="CopyKeyButton_Click" Content="复制 Key" />
                            <Button x:Name="CopyTextButton" Click="CopyTextButton_Click" Content="复制全文" />
                            <TextBlock x:Name="DetailHint" VerticalAlignment="Center" FontSize="11" Opacity="0.55" />
                        </StackPanel>

                        <TextBlock Text="KEY" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox x:Name="DetailKey" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 TextWrapping="Wrap" Text="(未选择条目)" />

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="业务域 / 字段语义" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="DetailDomainField" FontSize="12" TextWrapping="Wrap" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="主题标签 / 本地化 ID" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="DetailTagsId" FontSize="12" TextWrapping="Wrap" Text="—" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="所属表" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox x:Name="DetailTable" IsReadOnly="True" FontSize="11.5"
                                 TextWrapping="Wrap" Text="—" />

                        <TextBlock Text="全文" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox x:Name="DetailBody" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontSize="12.5" Text="(未选择条目)" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Padding="12,6"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing x:Name="BusyRing" Width="14" Height="14" IsActive="False" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" FontSize="11.5" VerticalAlignment="Center" Text="未加载" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" HorizontalAlignment="Right" FontSize="11" Opacity="0.65"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
